{
  "name": "gvcn-pro-web",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm run build && node server.mjs",
    "start": "node server.mjs",
    "build": "node scripts/build.mjs && npm run build:css",
    "build:css": "tailwindcss -c ./tailwind.config.cjs -i ./src/tailwind.css -o ./dist/assets/app.css --minify",
    "test": "node --test tests/*.test.mjs",
    "check": "npm test && npm run build"
  },
  "devDependencies": {
    "tailwindcss": "3.4.17"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@google/genai": "^2.24.0"
  }
}
